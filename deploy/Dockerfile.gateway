# Slim gateway image: only the proxy package + its two runtime deps.
#
# The full Merlin image carries the agent runtime, the TUI and every provider SDK. The gateway
# needs none of that: `merlin_cli.proxy.entry` imports cleanly with zero heavy modules (verified:
# no merlin_cli.auth, no agent.credential_pool, no rich/textual), so this image stays small and
# rebuilds fast.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

RUN pip install --no-cache-dir "aiohttp>=3.9,<4" "segno>=1.5,<2"

WORKDIR /app
COPY merlin_cli/__init__.py /app/merlin_cli/__init__.py
COPY merlin_cli/proxy /app/merlin_cli/proxy

# Fail the build (not the deploy) if the entry stops importing.
RUN python -c "from merlin_cli.proxy.entry import main; from merlin_cli.proxy.adapters import adapter_names; print('adapters:', adapter_names())"

EXPOSE 8645 8680
ENTRYPOINT ["python", "-m", "merlin_cli.proxy.entry"]
